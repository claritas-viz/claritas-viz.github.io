---
import ClientShowcase from "../components/ClientShowcase.astro";
const features=[
 ["Columnar core","Contiguous numerics and dictionary-encoded categoricals keep scans compact and cache-aware."],
 ["One logical plan","SQL, DAX, and native requests compile into a shared plan; unsupported constructs fail explicitly."],
 ["Visualization search","Chart specifications can be mutated and scored instead of hard-coding one view."],
 ["Presentation emitters","PowerPoint/OpenXML, Google Slides, and Reveal output originate from one narrative-ready spec."],
 ["Live panels","Streaming dashboards, semantic models, and workbook grids expose the engine over HTTP."],
 ["Extensible runtime","Public seams leave room for Arrow/DataFusion, SIMD kernels, parallel reducers, and new emitters."],
];
const samples=[
 {id:"sql",label:"SQL",file:"analysis.sql",code:`SELECT
  region,
  SUM(revenue) AS revenue,
  SUM(margin) AS margin
FROM sales
WHERE booked_at >= DATE '2026-01-01'
GROUP BY region
ORDER BY revenue DESC;`,note:"SQL compiles into the same internal logical plan used by the other query surfaces."},
 {id:"typescript",label:"TypeScript / HTTP",file:"analysis.ts",code:`const response = await fetch(baseUrl + "/v1/query", {
  method: "POST",
  headers: {
    "content-type": "application/json",
    authorization: "Bearer " + token,
  },
  body: JSON.stringify({
    dialect: "sql",
    query,
    output: { kind: "visualization", goal: "compare regions" },
  }),
});
const result = await response.json();`,note:"HTTP integration against the current service boundary; a dedicated generated client remains tracked."},
 {id:"json",label:"Native plan JSON",file:"plan.json",code:`{
  "source": "sales",
  "groupBy": ["region"],
  "measures": [
    {"name": "revenue", "aggregate": "sum"},
    {"name": "margin", "aggregate": "sum"}
  ],
  "presentation": {
    "goal": "compare regional performance",
    "formats": ["powerpoint", "reveal"]
  }
}`,note:"The native surface makes semantic intent and presentation output explicit."},
 {id:"mcp",label:"MCP tool call",file:"mcp.json",code:`{
  "name": "claritas_query",
  "arguments": {
    "dialect": "sql",
    "query": "SELECT region, SUM(revenue) FROM sales GROUP BY region",
    "recommend_visualization": true
  }
}`,note:"The MCP boundary supports agent-driven analysis without granting an unbounded execution surface."},
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Columnar analytics that turns records into charts, dashboards, and presentations."><meta name="theme-color" content="#071826"><title>Claritas — analytics that communicates</title></head><body>
<header><a class="brand" href="/"><b>C</b> Claritas</a><nav><a href="#platform">Platform</a><a href="#clients">Integrate</a><a href="https://github.com/claritas-viz">GitHub ↗</a></nav></header>
<main><section class="hero"><div><p class="eyebrow">Columnar analytics · Visualization search</p><h1>From raw columns to a <em>clear decision.</em></h1><p class="lede">Claritas compiles analytical intent into one logical plan, explores visualization choices, and emits dashboards or full presentations from the same specification.</p><div class="actions"><a class="primary" href="https://github.com/claritas-viz">Explore the engine ↗</a><a href="#clients">See integrations</a></div><ul><li>Columnar execution</li><li>SQL · DAX · native</li><li>Slides from the same spec</li></ul></div><div class="visual"><span class="mesh"></span><div class="core"><small>LOGICAL PLAN</small><strong>one source</strong><span>Query once. Explain everywhere.</span></div><div class="chip c1">INPUT<b>columns</b></div><div class="chip c2">SEARCH<b>evolutionary</b></div><div class="chip c3">OUTPUT<b>charts</b></div><div class="chip c4">DELIVERY<b>decks</b></div><svg viewBox="0 0 400 300" aria-hidden="true"><path d="M45 225 C120 170 145 230 210 132 S320 78 365 42"/><circle cx="45" cy="225" r="5"/><circle cx="210" cy="132" r="5"/><circle cx="365" cy="42" r="5"/></svg></div></section>
<section class="metrics"><div><b>3</b><span>query surfaces</span></div><div><b>2D→XD</b><span>visual search</span></div><div><b>3</b><span>presentation emitters</span></div><div><b>0</b><span>silent fallbacks</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Analytics with an editorial layer</p><h2>The engine does more than answer the query.</h2><p class="intro">Execution, semantic modeling, visualization search, and presentation output stay connected—but independently testable—so the result can move from analysis to a room full of decision-makers.</p><div class="features">{features.map(([title,body],index)=><article><small>{String(index+1).padStart(2,"0")}</small><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<div id="clients"><ClientShowcase title="Ask for analysis from SQL, TypeScript, a native plan, or an agent tool." description="Claritas does not yet publish a dedicated public claritas-clients package. These are current API and MCP integration examples, labeled honestly until generated clients land." source="https://github.com/claritas-viz" samples={samples}/></div>
<section class="flow"><div><p class="eyebrow">One analytical story</p><h2>Compile once. Explore, render, and present.</h2></div><div class="steps"><span>records</span><b>→</b><span>logical plan</span><b>→</b><span>reducers</span><b>→</b><span>viz search</span><b>→</b><span>presentation</span></div><p>Execution results and presentation artifacts share provenance through the logical plan.</p></section>
<section class="closing"><p class="eyebrow">Clarity is a system property</p><h2>Make the analysis survive the handoff.</h2><p>Follow the columnar engine, visualization server, MCP boundary, and presentation emitters.</p><a href="https://github.com/claritas-viz">Open the organization ↗</a></section></main><footer><span>© 2026 Claritas</span><a href="https://github.com/claritas-viz/data-viz-server.rs">Data viz server</a></footer></body></html>
<style is:global>:root{--accent:#0891b2;--hot:#4f46e5;--ink:#071826;--muted:#5f6b7c;--paper:#f5fafb}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;overflow-x:hidden;background:linear-gradient(180deg,#ecfeff,var(--paper) 34rem);color:var(--ink);font:16px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{font-weight:900;text-decoration:none}.brand b{display:inline-grid;width:2.2rem;aspect-ratio:1;place-items:center;margin-right:.5rem;border-radius:.7rem;background:var(--ink);color:white}nav{display:flex;gap:1.3rem;font-size:.88rem;font-weight:750}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .72rem/1 ui-monospace,monospace;letter-spacing:.18em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.3rem;font-size:clamp(3.4rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:46rem;color:var(--muted);font-size:1.12rem}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1.05rem;border:1px solid #0f172a18;border-radius:.8rem;font-weight:800;text-decoration:none}.actions .primary{background:var(--ink);color:white}.hero ul{display:flex;flex-wrap:wrap;gap:1rem;margin:0;padding:0;color:var(--muted);font-size:.82rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:31rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 48%,#0891b240,transparent 38%),linear-gradient(145deg,#061421,#101e38);box-shadow:0 35px 90px #0f172a42}.mesh{position:absolute;inset:0;background-image:linear-gradient(#ffffff0d 1px,transparent 1px),linear-gradient(90deg,#ffffff0d 1px,transparent 1px);background-size:2.3rem 2.3rem}.visual svg{position:absolute;inset:6rem 3rem 4rem;width:calc(100% - 6rem);height:calc(100% - 10rem);fill:none;stroke:#22d3ee;stroke-width:3}.visual circle{fill:#a5f3fc}.core,.chip{position:absolute;z-index:2;border:1px solid #ffffff20;background:#0f172bcc;color:white;backdrop-filter:blur(14px)}.core{top:50%;left:50%;display:grid;width:13.5rem;padding:1.2rem;border-radius:1.2rem;transform:translate(-50%,-50%)}.core small,.chip{font:700 .65rem/1.4 ui-monospace,monospace;letter-spacing:.1em}.core strong{margin:.4rem 0;font-size:1.35rem}.core span{color:#94a3b8;font-size:.8rem}.chip{display:grid;min-width:8rem;padding:.75rem;border-radius:.9rem;color:#94a3b8}.chip b{color:white}.c1{top:10%;left:7%}.c2{top:14%;right:7%}.c3{bottom:12%;left:7%}.c4{right:7%;bottom:9%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #0f172a16;border-radius:1.2rem;background:#ffffffb8;box-shadow:0 20px 55px #0f172a10}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #0f172a16}.metrics b{font-size:1.35rem}.metrics span{color:var(--muted);font-size:.78rem}.platform{padding:8rem 0}.platform h2,.flow h2,.closing h2{max-width:15ch;margin:.6rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:15rem;padding:1.3rem;border:1px solid #0f172a14;border-radius:1.2rem;background:#ffffffc4}.features small{color:var(--accent);font:800 .7rem/1 ui-monospace,monospace}.features h3{margin:2.4rem 0 .6rem;font-size:1.25rem}.features p{color:var(--muted)}.flow{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem 4rem;align-items:end;margin:9rem 0;padding:clamp(2rem,6vw,5rem);border-radius:1.7rem;background:#071826;color:white}.flow .eyebrow{color:#67e8f9}.flow>p{grid-column:2;margin:0;color:#94a3b8}.steps{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap}.steps span{padding:.65rem .8rem;border:1px solid #ffffff20;border-radius:.65rem;background:#ffffff0b;font:650 .75rem/1 ui-monospace,monospace}.steps b{color:#22d3ee}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:2rem;background:linear-gradient(125deg,var(--accent),var(--hot));color:white}.closing .eyebrow{color:#ffffffc4}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;justify-content:flex-end;gap:1.5rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.8rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.features{grid-template-columns:1fr 1fr}.flow{grid-template-columns:1fr}.flow>p{grid-column:1}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:25rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style>
