---
import PublicIntakeForm from "../components/PublicIntakeForm.astro";
import PublicIntakeLayout from "../layouts/PublicIntakeLayout.astro";

const fields = [
  {
    name: "fullName",
    label: "Full name",
    required: true,
    autocomplete: "name",
    maxLength: 120,
  },
  {
    name: "email",
    label: "Email",
    kind: "email",
    required: true,
    autocomplete: "email",
    maxLength: 254,
  },
  {
    name: "organization",
    label: "Organization",
    autocomplete: "organization",
    maxLength: 160,
  },
  {
    name: "budgetRange",
    label: "Indicative budget",
    kind: "select",
    options: [
      { label: "Under $10,000", value: "under-10k" },
      { label: "$10,000–$25,000", value: "10k-25k" },
      { label: "$25,000–$50,000", value: "25k-50k" },
      { label: "$50,000–$100,000", value: "50k-100k" },
      { label: "$100,000+", value: "100k-plus" },
      { label: "Not determined", value: "not-determined" },
    ],
  },
  {
    name: "targetTimeline",
    label: "Target timeline",
    placeholder: "For example: pilot in Q4",
    maxLength: 160,
  },
  {
    name: "projectSummary",
    label: "Project summary",
    kind: "textarea",
    required: true,
    placeholder: "Describe the data, decisions, integrations, and deliverables involved.",
    help: "Do not include passwords, API keys, regulated data, or confidential datasets.",
    maxLength: 4000,
    rows: 8,
  },
] as const;
---
<PublicIntakeLayout
  title="Request a quote"
  description="Request a Claritas analytics, visualization, or integration quote."
  eyebrow="Project intake"
>
  <div slot="heading">
    <h1>Request a Claritas project quote.</h1>
    <p class="lede">
      Share the decision you need to support and the systems involved. This form creates a technical
      receipt; scope, pricing, and delivery dates are confirmed separately.
    </p>
  </div>
  <PublicIntakeForm
    formId="quote-request"
    endpoint="/v1/intake/quotes"
    submitLabel="Submit quote request"
    fields={fields}
  />
</PublicIntakeLayout>
