---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const {
  title,
  description,
  eyebrow = "Claritas public intake",
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071826" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} · Claritas</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Claritas home"><b aria-hidden="true">C</b> Claritas</a>
        <nav aria-label="Public intake">
          <a href="/get-started/">Get started</a>
          <a href="/quote/">Quote</a>
          <a href="/pre-interest/">Pre-interest</a>
          <a href="/apply/">Apply</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <header class="page-heading">
        <p class="eyebrow">{eyebrow}</p>
        <slot name="heading" />
      </header>
      <slot />
    </main>
    <footer>
      <span>© 2026 Claritas</span>
      <nav aria-label="Footer navigation">
        <a href="/">Product</a>
        <a href="https://github.com/claritas-viz">GitHub</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --accent: #0e7490;
    --accent-strong: #155e75;
    --ink: #071826;
    --muted: #526171;
    --paper: #f4fafb;
    --panel: #ffffff;
    --border: #cbd5e1;
    --danger: #9f1239;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--paper);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 5%, rgb(8 145 178 / 14%), transparent 30rem),
      linear-gradient(180deg, #ecfeff, var(--paper) 32rem);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
  }

  a { color: inherit; }
  button, input, select, textarea { font: inherit; }
  button, input, select, textarea, a { outline-offset: 3px; }
  :focus-visible { outline: 3px solid #0e7490; }

  .skip-link {
    position: fixed;
    z-index: 1000;
    top: .75rem;
    left: .75rem;
    padding: .65rem .9rem;
    border-radius: .55rem;
    background: var(--ink);
    color: white;
    transform: translateY(-180%);
  }
  .skip-link:focus { transform: translateY(0); }

  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    border-bottom: 1px solid rgb(15 23 42 / 10%);
    background: rgb(244 250 251 / 92%);
    backdrop-filter: blur(16px);
  }
  .header-inner,
  main,
  footer {
    width: min(70rem, calc(100% - 2rem));
    margin-inline: auto;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: .8rem;
  }
  .brand {
    font-weight: 900;
    text-decoration: none;
  }
  .brand b {
    display: inline-grid;
    width: 2.15rem;
    margin-right: .45rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: .7rem;
    background: var(--ink);
    color: white;
  }
  .site-header nav,
  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .site-header nav a,
  footer nav a {
    font-size: .9rem;
    font-weight: 750;
    text-decoration: none;
  }
  .site-header nav a:hover,
  footer nav a:hover { text-decoration: underline; }

  main { padding-block: clamp(3rem, 8vw, 6rem); }
  .page-heading { max-width: 50rem; margin-bottom: 2rem; }
  .eyebrow {
    margin: 0;
    color: var(--accent-strong);
    font: 800 .75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 15ch;
    margin: .7rem 0 1rem;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: .98;
    letter-spacing: -.055em;
  }
  .lede {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid rgb(15 23 42 / 10%);
    color: var(--muted);
    font-size: .85rem;
  }

  @media (max-width: 46rem) {
    .header-inner,
    footer { align-items: flex-start; flex-direction: column; }
    .site-header { position: static; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
